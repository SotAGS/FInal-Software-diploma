<section class="card-principal">
  <h1>Registrar Venta</h1>

  <input type="text" placeholder="Buscar producto...">

  <table>
    <thead>
      <tr>
        <th>Producto</th>
        <th>Cantidad</th>
        <th>Precio</th>
        <th>Subtotal</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Pan</td>
        <td>2</td>
        <td>$500</td>
        <td>$1000</td>
        <td><button class="btn-danger">X</button></td>
      </tr>
    </tbody>
  </table>

  <div class="total">
    Total: $1000
  </div>

  <div style="margin-top:20px;">
    <button class="btn-secondary">Cancelar</button>
    <button class="btn-success">Confirmar Venta</button>
  </div>
</section>
