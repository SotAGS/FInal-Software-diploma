        <td><%= o.estado.constructor.name %></td>
        <td><button class="btn-menu btn-uniforme" data-target="det-<%= o['id'] %>">Menú</button></td>
      </tr>
      <tr id="det-<%= o['id'] %>" class="detalle" style="display:none">
        <td colspan="5">
          <strong>Items Solicitados:</strong>
          <ul>
            <% (o.items||[]).forEach(function(it){ 
              const prod = (typeof productosMap !== 'undefined') ? productosMap[it.productoId] : null;
            %>
              <li><%= prod ? prod.getNombre() : ('Producto #' + it.productoId) %> — Cantidad: <%= it.cantidad %></li>
            <% }) %>
          </ul>
          <strong>Proveedor:</strong>
          <%= (typeof proveedoresMap !== 'undefined' && proveedoresMap[o.proveedorId])
                ? proveedoresMap[o.proveedorId].getNombre()
                : 'N/A' %>
        </td>
      </tr>
    <% }) %>
  <% } %>
</table>
</div>

<style>
  .btn-uniforme {
    width: 170px;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    text-align: center;
  }

  .acciones-ordenes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .acciones-ordenes form {
    display: inline-flex !important;
  }
</style>

<script>
  document.addEventListener('click', function(e){
    if (e.target && e.target.classList.contains('btn-menu')){
      const target = e.target.getAttribute('data-target');
      const row = document.getElementById(target);
      if (row) row.style.display = row.style.display === 'none' ? 'table-row' : 'none';
    }
  });
</script>