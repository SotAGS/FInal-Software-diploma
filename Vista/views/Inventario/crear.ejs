<h1>Crear Producto</h1>

<% if (typeof error !== 'undefined' && error) { %>
  <div style="margin-bottom:12px;padding:10px 12px;border:1px solid #ffcdd2;background:#ffebee;color:#c62828;border-radius:6px;">
    <%= error %>
  </div>
<% } %>

<form method="POST" action="/inventario/crear">

  <input type="text" name="nombre" placeholder="Nombre" value="<%= typeof nombre !== 'undefined' ? nombre : '' %>" required />

  <input type="number" step="0.01" name="precioCompra" placeholder="Precio de compra" value="<%= typeof precioCompra !== 'undefined' ? precioCompra : '' %>" required />

  <input type="number" step="0.01" name="precioVenta" placeholder="Precio de venta" value="<%= typeof precioVenta !== 'undefined' ? precioVenta : '' %>" required />

  <input type="number" name="stock" placeholder="Stock" value="<%= typeof stock !== 'undefined' ? stock : '' %>" required />

  <select name="proveedorId" required>
    <option value="">-- Seleccionar proveedor --</option>
    <% (proveedores || []).forEach(function(pr){ %>
      <option value="<%= pr.getId() %>" <%= String(proveedorId || '') === String(pr.getId()) ? 'selected' : '' %>>
        <%= pr.getNombre() %>
      </option>
    <% }) %>
  </select>

  <button class="btn-success">Guardar</button>
</form>