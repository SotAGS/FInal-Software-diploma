<h1>Listado de Productos</h1>

<% const puedeEditar = usuario && usuario.puede("EDITAR_PRODUCTO"); %>
<% const puedeEliminar = usuario && usuario.puede("ELIMINAR_PRODUCTO"); %>
<% const puedeCrear = usuario && usuario.puede("CREAR_PRODUCTO"); %>
<%
  const obtenerPrecioCompra = (p) => {
    if (typeof p.getPrecioCompra === 'function') return p.getPrecioCompra();
    if (typeof p.getPrecio === 'function') return p.getPrecio();
    if (typeof p.precioCompra !== 'undefined') return p.precioCompra;
    if (typeof p.precio_compra !== 'undefined') return p.precio_compra;
    if (typeof p.precio !== 'undefined') return p.precio;
    return 0;
  };

  const obtenerPrecioVenta = (p) => {
    if (typeof p.getPrecioVenta === 'function') return p.getPrecioVenta();
    if (typeof p.getPrecio === 'function') return p.getPrecio();
    if (typeof p.precioVenta !== 'undefined') return p.precioVenta;
    if (typeof p.precio_venta !== 'undefined') return p.precio_venta;
    if (typeof p.precio !== 'undefined') return p.precio;
    return 0;
  };
%>

<% if (success) { %>
  <div class="alert-success"><%= success %></div>
<% } %>
<% if (error) { %>
  <div class="alert-error"><%= error %></div>
<% } %>

<input
  id="filtroProductosListado"
  type="text"
  placeholder="Buscar producto por nombre o proveedor..."
  class="filtro-input"
/>

<h2>Productos Activos</h2>
<% if (productosActivos && productosActivos.length > 0) { %>
  <table>
    <tr>
      <th>Nombre</th>
      <th>Precio compra</th>
      <th>Precio venta</th>
      <th>Stock</th>
      <th>Proveedor</th>
      <% if (puedeEditar || puedeEliminar) { %>
        <th>Acciones</th>
      <% } %>
    </tr>

    <% productosActivos.forEach(function(p) { %>
      <tr data-producto-row data-search="<%= (p.getNombre() + ' ' + (p.getProveedorId() ? (proveedoresMap[p.getProveedorId()] || ('#' + p.getProveedorId())) : 'sin proveedor')).toLowerCase() %>">
        <td><%= p.getNombre() %></td>
        <td>$<%= Number(obtenerPrecioCompra(p) || 0).toFixed(2) %></td>
        <td>$<%= Number(obtenerPrecioVenta(p) || 0).toFixed(2) %></td>
        <td><%= p.getStock() %></td>
        <td><%= p.getProveedorId() ? (proveedoresMap[p.getProveedorId()] || ('#'+p.getProveedorId())) : 'Sin proveedor' %></td>

        <% if (puedeEditar || puedeEliminar) { %>
          <td>
            <% if (puedeEditar) { %>
              <a class="btn-primary" href="/inventario/editar/<%= p.getId() %>">Editar</a>
            <% } %>
            <% if (puedeEliminar) { %>
              <form method="POST" action="/inventario/eliminar/<%= p.getId() %>" style="display:inline">
                <button class="btn-danger" type="submit">Eliminar</button>
              </form>
              <form method="POST" action="/inventario/eliminar-definitivo/<%= p.getId() %>" style="display:inline" onsubmit="return confirm('¿Eliminar definitivamente este producto? Esta acción no se puede deshacer.');">
                <button class="btn-danger" type="submit">Eliminar definitivo</button>
              </form>
            <% } %>
          </td>
        <% } %>
      </tr>
    <% }) %>
  </table>
<% } else { %>
  <div class="alert-empty">
    No hay productos activos.
    <% if (puedeCrear) { %>
      <a href="/inventario/crear">Crear primer producto</a>
    <% } %>
  </div>
<% } %>

<h2 style="margin-top:24px;">Productos Eliminados (Recuperables)</h2>
<% if (productosEliminados && productosEliminados.length > 0) { %>
  <table>
    <tr>
      <th>Nombre</th>
      <th>Precio compra</th>
      <th>Precio venta</th>
      <th>Stock</th>
      <th>Proveedor</th>
      <% if (puedeEliminar) { %>
        <th>Acciones</th>
      <% } %>
    </tr>

    <% productosEliminados.forEach(function(p) { %>
      <tr data-producto-row data-search="<%= (p.getNombre() + ' ' + (p.getProveedorId() ? (proveedoresMap[p.getProveedorId()] || ('#' + p.getProveedorId())) : 'sin proveedor')).toLowerCase() %>">
        <td><%= p.getNombre() %></td>
        <td>$<%= Number(obtenerPrecioCompra(p) || 0).toFixed(2) %></td>
        <td>$<%= Number(obtenerPrecioVenta(p) || 0).toFixed(2) %></td>
        <td><%= p.getStock() %></td>
        <td><%= p.getProveedorId() ? (proveedoresMap[p.getProveedorId()] || ('#'+p.getProveedorId())) : 'Sin proveedor' %></td>
        <% if (puedeEliminar) { %>
          <td>
            <form method="POST" action="/inventario/recuperar/<%= p.getId() %>" style="display:inline">
              <button class="btn-primary" type="submit">Recuperar</button>
            </form>
            <form method="POST" action="/inventario/eliminar-definitivo/<%= p.getId() %>" style="display:inline" onsubmit="return confirm('¿Eliminar definitivamente este producto? Esta acción no se puede deshacer.');">
              <button class="btn-danger" type="submit">Eliminar definitivo</button>
            </form>
          </td>
        <% } %>
      </tr>
    <% }) %>
  </table>
<% } else { %>
  <div class="alert-empty">No hay productos eliminados para recuperar.</div>
<% } %>

<style>
  .alert-empty {
    margin-top: 16px;
    padding: 14px;
    border: 1px solid #ddd;
    background: #fafafa;
    border-radius: 6px;
  }

  .filtro-input {
    width: 100%;
    max-width: 420px;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 6px;
    margin-top: 8px;
    margin-bottom: 12px;
  }

  .alert-empty a {
    margin-left: 8px;
    font-weight: bold;
  }

  .alert-success {
    margin-top: 16px;
    padding: 12px;
    border: 1px solid #c8e6c9;
    background: #e8f5e9;
    color: #2e7d32;
    border-radius: 6px;
  }

  .alert-error {
    margin-top: 16px;
    padding: 12px;
    border: 1px solid #ffcdd2;
    background: #ffebee;
    color: #c62828;
    border-radius: 6px;
  }
</style>

<script>
  (function () {
    const input = document.getElementById('filtroProductosListado');
    if (!input) return;

    const rows = Array.from(document.querySelectorAll('[data-producto-row]'));

    const filtrar = () => {
      const termino = input.value.trim().toLowerCase();
      rows.forEach((row) => {
        const texto = (row.getAttribute('data-search') || '').toLowerCase();
        const visible = !termino || texto.includes(termino);
        row.style.display = visible ? '' : 'none';
      });
    };

    input.addEventListener('input', filtrar);
  })();
</script>