<h1>Recuperar contraseña</h1>
<p>El sistema usa tu email principal de login y envía el enlace al email de backup asociado.</p>

<% if (error) { %>
  <p style="color:red"><%= error %></p>
<% } %>

<% if (success) { %>
  <p style="color:green"><%= success %></p>
<% } %>

<% if (resetUrl) { %>
  <p>
    Link de recuperación:
    <a href="<%= resetUrl %>"><%= resetUrl %></a>
  </p>
<% } %>

<% if (mostrarFormulario !== false) { %>
  <form action="/forgot-password" method="POST">
    <div>
      <input type="email" name="email" placeholder="Email principal" required value="<%= emailPrefill || '' %>" />
    </div>

    <button type="submit">Enviar correo de recuperación</button>
  </form>
<% } %>

<div style="margin-top: 12px;">
  <a href="/login">Volver al login</a>
</div>
