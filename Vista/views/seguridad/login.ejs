

<h1>Login</h1>

<% if (error) { %>
  <p style="color:red"><%= error %></p>
<% } %>

<% if (success) { %>
  <p style="color:green"><%= success %></p>
<% } %>

<form action="/login" method="POST">
  <div>
    <input id="login-email" type="email" name="email" placeholder="Email" required />
  </div>

  <div>
    <input type="password" name="password" placeholder="Password" required />
  </div>

  <button type="submit">Ingresar</button>
</form>

<div style="margin-top: 12px;">
  <a id="forgot-password-link" href="/forgot-password">Recuperar contraseña</a>
</div>

<script>
  (function () {
    var emailInput = document.getElementById("login-email");
    var forgotLink = document.getElementById("forgot-password-link");

    if (!emailInput || !forgotLink) {
      return;
    }

    var updateForgotHref = function () {
      var emailValue = (emailInput.value || "").trim();
      forgotLink.href = emailValue
        ? "/forgot-password?email=" + encodeURIComponent(emailValue)
        : "/forgot-password";
    };

    emailInput.addEventListener("input", updateForgotHref);
    updateForgotHref();
  })();
</script>
  