<h1>Ventas a Clientes</h1>

<% if (typeof session !== 'undefined' && session.message) { %>
  <div class="alert"><%= session.message %></div>
  <% session.message = null; %>
<% } %>

<div class="ventas-layout">
  <div class="ventas-columna-principal">
    <h3>Agregar producto al carrito</h3>
    <form method="POST" action="/Ventas/cart/add" class="ventas-formulario">
      <input
        type="text"
        id="filtroProductosVenta"
        placeholder="Buscar producto por nombre..."
        class="input-filtro"
      />
      <select name="productoId" id="selectProductosVenta" size="10" class="select-productos">
        <% productos.forEach(function(p){ %>
          <option value="<%= p.getId() %>" data-search="<%= p.getNombre().toLowerCase() %>">
            <%= p.getNombre() %> - $<%= p.getPrecio() %> (stock: <%= p.getStock() %>)
          </option>
        <% }) %>
      </select>
      <label for="cantidadVenta" class="label-cantidad">Cantidad</label>
      <input id="cantidadVenta" type="number" name="cantidad" min="1" value="1" class="input-cantidad" />
      <button class="btn-success">Agregar al carrito</button>
    </form>
  </div>

  <div class="ventas-columna-secundaria">
    <h3>Carrito de venta</h3>

    <% if (!cart || !cart.length) { %>
      <p>El carrito esta vacio.</p>
    <% } else { %>
      <table>
        <tr>
          <th>Producto</th>
          <th>Cantidad</th>
          <th>P. Unit.</th>
          <th>Subtotal</th>
          <th></th>
        </tr>
        <% cartDetalle.forEach(function(item){ %>
          <tr>
            <td><%= item.nombre %></td>
            <td><%= item.cantidad %></td>
            <td>$<%= item.precioUnitario.toFixed(2) %></td>
            <td>$<%= item.subtotal.toFixed(2) %></td>
            <td>
              <form method="POST" action="/Ventas/cart/remove">
                <input type="hidden" name="productoId" value="<%= item.productoId %>" />
                <button class="btn-danger">Quitar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </table>

      <form method="POST" action="/Ventas/confirmar" class="form-confirmar-venta">
        <label for="clienteNombre">Cliente</label>
        <input id="clienteNombre" name="clienteNombre" type="text" value="Consumidor final" maxlength="150" required />
        <p><strong>Total:</strong> $<%= totalCarrito.toFixed(2) %></p>
        <button class="btn-success">Confirmar venta</button>
      </form>
    <% } %>
  </div>
</div>

<hr />

<h3>Historial de ventas</h3>
<table>
  <tr>
    <th>ID</th>
    <th>Fecha</th>
    <th>Cliente</th>
    <th>Total</th>
    <th>Detalle</th>
  </tr>
  <% if (!ventas || !ventas.length) { %>
    <tr><td colspan="5">No hay ventas registradas.</td></tr>
  <% } else { %>
    <% ventas.forEach(function(v){ %>
      <tr>
        <td><%= v.getId() %></td>
        <td><%= v.getFechaCreacion() ? new Date(v.getFechaCreacion()).toLocaleDateString('es-AR') : '-' %></td>
        <td><%= v.getClienteNombre() %></td>
        <td>$<%= Number(v.getTotal()).toFixed(2) %></td>
        <td>
          <% const detalle = v.getItems().map(function(it){
              const prod = productosMap[it.productoId];
              const nombre = prod ? prod.getNombre() : ('Producto #' + it.productoId);
              return nombre + ' x ' + it.cantidad;
            }).join(' | '); %>
          <%= detalle || '-' %>
        </td>
      </tr>
    <% }) %>
  <% } %>
</table>

<style>
  .ventas-layout {
    display: grid;
    grid-template-columns: minmax(320px, 0.9fr) minmax(500px, 1.3fr);
    gap: 20px;
    margin-bottom: 20px;
  }

  .ventas-columna-principal,
  .ventas-columna-secundaria {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .ventas-formulario {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .form-confirmar-venta {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 360px;
    margin-top: 12px;
  }

  .input-filtro,
  .input-cantidad,
  #clienteNombre {
    width: 100%;
    box-sizing: border-box;
  }

  .select-productos {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .ventas-columna-secundaria table {
    width: 100%;
    table-layout: auto;
  }

  .ventas-columna-secundaria td,
  .ventas-columna-secundaria th {
    white-space: nowrap;
    vertical-align: middle;
  }

  .ventas-columna-secundaria td:first-child,
  .ventas-columna-secundaria th:first-child {
    white-space: normal;
    width: 32%;
  }

  .ventas-columna-secundaria td:last-child,
  .ventas-columna-secundaria th:last-child {
    width: 90px;
    text-align: center;
  }

  .ventas-columna-secundaria .btn-danger {
    white-space: nowrap;
    min-width: 76px;
    padding: 8px 10px;
  }

  .label-cantidad {
    font-weight: 600;
  }

  @media (max-width: 980px) {
    .ventas-layout {
      grid-template-columns: 1fr;
    }

    .select-productos {
      min-width: 100%;
    }
  }
</style>

<script>
  (function () {
    const input = document.getElementById('filtroProductosVenta');
    const select = document.getElementById('selectProductosVenta');
    if (!input || !select) return;

    const options = Array.from(select.options);

    const filtrar = () => {
      const termino = input.value.trim().toLowerCase();
      let primerVisible = null;

      options.forEach((opt) => {
        const texto = (opt.getAttribute('data-search') || opt.textContent || '').toLowerCase();
        const visible = !termino || texto.includes(termino);
        opt.style.display = visible ? '' : 'none';
        if (visible && !primerVisible) primerVisible = opt;
      });

      if (primerVisible && (select.selectedOptions.length === 0 || select.selectedOptions[0].style.display === 'none')) {
        primerVisible.selected = true;
      }
    };

    input.addEventListener('input', filtrar);
  })();
</script>
