<h1>Ventas a Clientes</h1>

<% if (typeof session !== 'undefined' && session.message) { %>
  <% const esErrorMensaje = /(insuficiente|no se pudo|debe|no existe|vacio|invál|inval)/i.test(session.message); %>
  <div class="alert <%= esErrorMensaje ? 'alert-error' : 'alert-success' %>"><%= session.message %></div>
  <% session.message = null; %>
<% } %>

<div class="ventas-layout">
  <div class="ventas-columna-principal">
    <h3>Agregar producto al carrito</h3>
    <form method="POST" action="/Ventas/cart/add" class="ventas-formulario">
      <input
        type="text"
        id="filtroProductosVenta"
        placeholder="Buscar producto por nombre..."
        class="input-filtro"
      />
      <select name="productoId" id="selectProductosVenta" size="10" class="select-productos">
        <% productos.forEach(function(p){ %>
          <option value="<%= p.getId() %>" data-search="<%= p.getNombre().toLowerCase() %>">
            <%= p.getNombre() %> - $<%= p.getPrecio() %> (stock: <%= p.getStock() %>)
          </option>
        <% }) %>
      </select>
      <label for="cantidadVenta" class="label-cantidad">Cantidad</label>
      <input id="cantidadVenta" type="number" name="cantidad" min="1" value="1" class="input-cantidad" />
      <button class="btn-success">Agregar al carrito</button>
    </form>

    <form method="POST" action="/Ventas/confirmar" class="form-confirmar-venta">
      <label for="clienteNombreVisible">Cliente</label>
      <input id="clienteNombreVisible" type="text" value="Consumidor final" readonly />
      <input type="hidden" name="clienteNombre" value="Consumidor final" />
      <p><strong>Total:</strong> $<%= totalCarrito.toFixed(2) %></p>
      <button class="btn-success" <%= (!cart || !cart.length) ? 'disabled' : '' %>>Confirmar venta</button>
      <% if (!cart || !cart.length) { %>
        <small class="ventas-ayuda">Agregá al menos un producto para confirmar la venta.</small>
      <% } %>
    </form>
  </div>

  <div class="ventas-columna-secundaria">
    <h3>Carrito de venta</h3>

    <% if (!cart || !cart.length) { %>
      <p>El carrito esta vacio.</p>
    <% } else { %>
      <div class="carrito-scroll">
        <table class="carrito-table">
          <thead>
            <tr>
              <th>Producto</th>
              <th>Cantidad</th>
              <th>P. Unit.</th>
              <th>Subtotal</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% cartDetalle.forEach(function(item){ %>
              <tr>
                <td><%= item.nombre %></td>
                <td><%= item.cantidad %></td>
                <td>$<%= item.precioUnitario.toFixed(2) %></td>
                <td>$<%= item.subtotal.toFixed(2) %></td>
                <td>
                  <form method="POST" action="/Ventas/cart/remove">
                    <input type="hidden" name="productoId" value="<%= item.productoId %>" />
                    <button class="btn-danger">Quitar</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<hr />

<h3>Historial de ventas</h3>
<table>
  <tr>
    <th>ID</th>
    <th>Fecha</th>
    <th>Cliente</th>
    <th>Total</th>
    <th>Detalle</th>
  </tr>
  <% if (!ventas || !ventas.length) { %>
    <tr><td colspan="5">No hay ventas registradas.</td></tr>
  <% } else { %>
    <% ventas.forEach(function(v){ %>
      <tr>
        <td><%= v.getId() %></td>
        <td><%= v.getFechaCreacion() ? new Date(v.getFechaCreacion()).toLocaleDateString('es-AR') : '-' %></td>
        <td><%= v.getClienteNombre() %></td>
        <td>$<%= Number(v.getTotal()).toFixed(2) %></td>
        <td>
          <% const detalle = v.getItems().map(function(it){
              const prod = productosMap[it.productoId];
              const nombre = prod ? prod.getNombre() : ('Producto #' + it.productoId);
              return nombre + ' x ' + it.cantidad;
            }).join(' | '); %>
          <%= detalle || '-' %>
        </td>
      </tr>
    <% }) %>
  <% } %>
</table>

<style>
  .card-principal {
    max-width: 1200px;
  }

  .ventas-layout {
    display: grid;
    grid-template-columns: minmax(330px, 0.8fr) minmax(620px, 1.2fr);
    gap: 20px;
    margin-bottom: 20px;
    align-items: start;
  }

  .ventas-columna-principal,
  .ventas-columna-secundaria {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .ventas-formulario {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .form-confirmar-venta {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 12px;
    width: 100%;
  }

  .input-filtro,
  .input-cantidad,
  #clienteNombreVisible {
    width: 100%;
    box-sizing: border-box;
  }

  #clienteNombreVisible[readonly] {
    opacity: 0.95;
    cursor: not-allowed;
    background: rgba(255, 255, 255, 0.04);
  }

  .alert {
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 10px 12px;
    margin-bottom: 12px;
    font-weight: 600;
  }

  .alert-success {
    color: #b9f6ca;
    border-color: #2e7d32;
    background: rgba(46, 125, 50, 0.2);
  }

  .alert-error {
    color: #ffcdd2;
    border-color: #c62828;
    background: rgba(198, 40, 40, 0.2);
  }

  .select-productos {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .carrito-scroll {
    max-height: 340px;
    overflow-y: auto;
    overflow-x: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
  }

  .carrito-table {
    width: 100%;
    table-layout: fixed;
    margin-top: 0;
  }

  .carrito-table thead th {
    position: sticky;
    top: 0;
    z-index: 1;
  }

  .ventas-columna-secundaria table {
    width: 100%;
    table-layout: fixed;
  }

  .ventas-columna-secundaria td,
  .ventas-columna-secundaria th {
    white-space: nowrap;
    vertical-align: middle;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ventas-columna-secundaria td:first-child,
  .ventas-columna-secundaria th:first-child {
    width: 36%;
  }

  .ventas-columna-secundaria td:nth-child(2),
  .ventas-columna-secundaria th:nth-child(2) {
    width: 12%;
  }

  .ventas-columna-secundaria td:nth-child(3),
  .ventas-columna-secundaria th:nth-child(3) {
    width: 18%;
  }

  .ventas-columna-secundaria td:nth-child(4),
  .ventas-columna-secundaria th:nth-child(4) {
    width: 18%;
  }

  .ventas-columna-secundaria td:last-child,
  .ventas-columna-secundaria th:last-child {
    width: 16%;
    text-align: center;
  }

  .ventas-columna-secundaria .btn-danger {
    white-space: nowrap;
    min-width: 70px;
    padding: 8px 8px;
  }

  .ventas-ayuda {
    opacity: 0.75;
  }

  .label-cantidad {
    font-weight: 600;
  }

  @media (max-width: 980px) {
    .ventas-layout {
      grid-template-columns: 1fr;
    }

    .select-productos {
      min-width: 100%;
    }
  }
</style>

<script>
  (function () {
    const input = document.getElementById('filtroProductosVenta');
    const select = document.getElementById('selectProductosVenta');
    if (!input || !select) return;

    const options = Array.from(select.options);

    const filtrar = () => {
      const termino = input.value.trim().toLowerCase();
      let primerVisible = null;

      options.forEach((opt) => {
        const texto = (opt.getAttribute('data-search') || opt.textContent || '').toLowerCase();
        const visible = !termino || texto.includes(termino);
        opt.style.display = visible ? '' : 'none';
        if (visible && !primerVisible) primerVisible = opt;
      });

      if (primerVisible && (select.selectedOptions.length === 0 || select.selectedOptions[0].style.display === 'none')) {
        primerVisible.selected = true;
      }
    };

    input.addEventListener('input', filtrar);
  })();
</script>
