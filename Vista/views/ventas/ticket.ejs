<%
  const ventaId = venta.getId();
  const fechaVenta = venta.getFechaCreacion() ? new Date(venta.getFechaCreacion()) : new Date();
  const fechaFormateada = fechaVenta.toLocaleDateString('es-AR');
  const horaFormateada = fechaVenta.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' });
%>

<div class="ticket-wrapper">
  <article class="ticket-card" id="ticketPago">
    <header class="ticket-header">
      <h1>Ticket de pago</h1>
      <p>Comprobante para cliente</p>
    </header>

    <section class="ticket-meta">
      <div><strong>Venta:</strong> #<%= ventaId %></div>
      <div><strong>Fecha:</strong> <%= fechaFormateada %> <%= horaFormateada %></div>
      <div><strong>Cliente:</strong> <%= venta.getClienteNombre() %></div>
    </section>

    <table class="ticket-table">
      <thead>
        <tr>
          <th>Producto</th>
          <th>Cant.</th>
          <th>Unitario</th>
          <th>Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% if (!itemsDetalle || !itemsDetalle.length) { %>
          <tr>
            <td colspan="4">No hay items en esta venta.</td>
          </tr>
        <% } else { %>
          <% itemsDetalle.forEach(function(item){ %>
            <tr>
              <td><%= item.productoNombre %></td>
              <td><%= item.cantidad %></td>
              <td>$<%= Number(item.precioUnitario || 0).toFixed(2) %></td>
              <td>$<%= Number(item.subtotal || 0).toFixed(2) %></td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
      <tfoot>
        <tr>
          <th colspan="3">TOTAL</th>
          <th>$<%= Number(venta.getTotal() || 0).toFixed(2) %></th>
        </tr>
      </tfoot>
    </table>

    <footer class="ticket-footer">
      Gracias por su compra.
    </footer>
  </article>

  <div class="ticket-actions no-print">
    <a href="/Ventas" class="btn-back">Volver a ventas</a>
    <button type="button" class="btn-print" onclick="window.print()">Imprimir ticket</button>
  </div>
</div>

<style>
  .ticket-wrapper {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ticket-card {
    background: #fff;
    color: #111;
    border-radius: 8px;
    border: 1px solid #d6d6d6;
    padding: 20px;
  }

  .ticket-header h1 {
    margin: 0;
    font-size: 1.45rem;
    letter-spacing: 0.2px;
  }

  .ticket-header p {
    margin: 6px 0 0;
    color: #444;
  }

  .ticket-meta {
    margin: 14px 0;
    display: grid;
    gap: 6px;
    font-size: 0.95rem;
  }

  .ticket-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .ticket-table th,
  .ticket-table td {
    border: 1px solid #d8d8d8;
    padding: 8px;
    text-align: left;
  }

  .ticket-table th:nth-child(2),
  .ticket-table td:nth-child(2),
  .ticket-table th:nth-child(3),
  .ticket-table td:nth-child(3),
  .ticket-table th:nth-child(4),
  .ticket-table td:nth-child(4) {
    text-align: right;
  }

  .ticket-table tfoot th {
    font-size: 1.03rem;
  }

  .ticket-footer {
    margin-top: 14px;
    font-size: 0.92rem;
    color: #333;
  }

  .ticket-actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
  }

  .btn-back,
  .btn-print {
    border: 1px solid #aaa;
    border-radius: 6px;
    padding: 9px 13px;
    text-decoration: none;
    background: #f4f4f4;
    color: #222;
    cursor: pointer;
    font-weight: 600;
  }

  .btn-print {
    border-color: #2e7d32;
    background: #2e7d32;
    color: #fff;
  }

  @media print {
    .no-print,
    nav,
    header,
    .alert {
      display: none !important;
    }

    body {
      background: #fff !important;
    }

    .ticket-wrapper {
      max-width: 100%;
      margin: 0;
      padding: 0;
    }

    .ticket-card {
      border: none;
      border-radius: 0;
      padding: 0;
    }
  }
</style>
