<div class="reportes-container">
  <h1><%= (typeof nombreLocal !== 'undefined' && nombreLocal) ? nombreLocal : 'Almacen Manager' %></h1>
  <h2>Resumen Mensual de Ventas</h2>
  <p class="subtitle">Cantidad total de productos vendidos por mes y producto más vendido en cada período</p>

  <div class="acciones-reporte no-print">
    <a href="/Reportes/pdf/resumen-ventas-mensual" class="btn btn-primary">Descargar PDF</a>
  </div>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <% if (datos && datos.length > 0) { %>
    <div class="report-section narrativo">
      <% datos.forEach(function(row){ %>
        <p>
          En <strong><%= row.mesNombre %></strong> se vendieron
          <strong><%= Number(row.totalProductosVendidos || 0) %></strong>
          productos totales. De los cuales el más vendido fue
          <strong><%= row.productoMasVendido %></strong>
          con <strong><%= Number(row.cantidadProductoMasVendido || 0) %></strong> unidades.
        </p>
      <% }) %>
    </div>

    <div class="report-section">
      <table class="report-table">
        <thead>
          <tr>
            <th>Mes</th>
            <th>Total productos vendidos</th>
            <th>Producto más vendido</th>
            <th>Cantidad del más vendido</th>
            <th>Total facturado</th>
          </tr>
        </thead>
        <tbody>
          <% datos.forEach(function(row){ %>
            <tr>
              <td><%= row.mesNombre %></td>
              <td class="text-center"><%= Number(row.totalProductosVendidos || 0) %></td>
              <td><%= row.productoMasVendido %></td>
              <td class="text-center"><%= Number(row.cantidadProductoMasVendido || 0) %></td>
              <td class="text-right">$<%= Number(row.totalVentas || 0).toFixed(2) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="report-section">
      <h3>Productos vendidos por mes</h3>
      <canvas id="ventasMensualesChart" height="85"></canvas>
    </div>
  <% } else { %>
    <p class="no-data">No hay datos de ventas para mostrar el resumen mensual.</p>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  window.__REPORT_READY__ = false;
  const datos = <%- JSON.stringify(datos || []) %>;

  if (datos.length > 0) {
    const ctx = document.getElementById('ventasMensualesChart').getContext('2d');
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const chartTextColor = isDark ? '#e5e7eb' : '#374151';

    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: datos.slice().reverse().map(x => x.mesNombre),
        datasets: [{
          label: 'Productos vendidos',
          data: datos.slice().reverse().map(x => Number(x.totalProductosVendidos || 0)),
          backgroundColor: 'rgba(33, 150, 243, 0.75)',
          borderColor: 'rgba(25, 118, 210, 1)',
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
          legend: {
            labels: {
              color: chartTextColor
            }
          }
        },
        scales: {
          x: {
            ticks: { color: chartTextColor },
            grid: { color: isDark ? 'rgba(148, 163, 184, 0.2)' : 'rgba(71, 85, 105, 0.2)' }
          },
          y: {
            beginAtZero: true,
            ticks: { color: chartTextColor },
            grid: { color: isDark ? 'rgba(148, 163, 184, 0.2)' : 'rgba(71, 85, 105, 0.2)' }
          }
        }
      }
    });

    setTimeout(() => {
      window.__REPORT_READY__ = true;
    }, 300);
  } else {
    window.__REPORT_READY__ = true;
  }
</script>

<style>
  .reportes-container {
    padding: 20px;
  }

  h2 {
    margin-top: 8px;
    color: #1B5E20;
  }

  .subtitle {
    color: #666;
    font-size: 14px;
    margin-bottom: 20px;
  }

  .acciones-reporte {
    margin-bottom: 16px;
  }

  .btn {
    display: inline-block;
    padding: 8px 14px;
    border-radius: 4px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-weight: bold;
  }

  .btn-primary {
    background-color: #2196f3;
    color: white;
  }

  .btn-primary:hover {
    background-color: #1976d2;
  }

  .alert {
    padding: 12px 16px;
    margin-bottom: 20px;
    border-radius: 4px;
  }

  .alert-error {
    background-color: #ffebee;
    color: #c62828;
    border-left: 4px solid #c62828;
  }

  .report-section {
    margin: 20px 0;
    padding: 20px;
    background-color: #f9f9f9;
    border-radius: 8px;
    border: 1px solid #ddd;
  }

  .narrativo p {
    margin: 0 0 10px 0;
    line-height: 1.45;
  }

  .narrativo p:last-child {
    margin-bottom: 0;
  }

  .report-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
  }

  .report-table th,
  .report-table td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid #ddd;
  }

  .report-table th {
    background-color: #f0f0f0;
    font-weight: bold;
    color: #333;
  }

  .report-table tr:hover {
    background-color: #f5f5f5;
  }

  .text-center {
    text-align: center;
  }

  .text-right {
    text-align: right;
  }

  .no-data {
    text-align: center;
    color: #999;
    padding: 30px;
    font-style: italic;
  }
</style>
